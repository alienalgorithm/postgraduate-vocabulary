            "path": "/workspace/work/video-audit70-20261113/article53-user-review-20261114/static-1080/after-summary.png",
            "PNG_sha256": "5fd23be115a1d4afebe27ad3b5398495517053beddf5d1db27d5c92c72842f1b",
