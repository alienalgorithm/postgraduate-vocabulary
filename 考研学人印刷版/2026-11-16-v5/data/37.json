 "notes": [
  {
   "sentence": 1,
   "chunk": 1,
   "source_English": "On Spitsbergen, in Norway's Svalbard archipelago,",
   "text": "（in Norway's Svalbard archipelago：同位语，补充说明 Spitsbergen 的位置）"
  },
  {
   "sentence": 1,
   "chunk": 2,
   "source_English": "a corridor has been drilled deep into a frosted hillside.",
   "text": "（has been drilled：现在完成时的被动语态）"
  },
  {
   "sentence": 2,
   "chunk": 1,
   "source_English": "At its end, cartons of precious seed",
   "text": "（its 指 corridor）"
  },
  {
   "sentence": 2,
   "chunk": 3,
   "source_English": "insulated by permanently frozen ground.",
   "text": "（insulated by…：过去分词短语，补充说明 repository）"
  },
  {
   "sentence": 3,
   "chunk": 2,
   "source_English": "to insure crops such as beans, rice, and wheat",
   "text": "（to insure…：不定式作目的状语；\ninsure A against B：为 A 投保，防范 B（被隔开的搭配））"
  },
  {
   "sentence": 3,
   "chunk": 3,
   "source_English": "against the horrors people dread, from atomic war to disease.",
   "text": "（people dread：定语从句，省略了关系代词，修饰 horrors；\nfrom A to B：从 A 到 B）"
  },
  {
   "sentence": 4,
   "chunk": 1,
   "source_English": "It has ample room for about four and a half million samples.",
   "text": "（这就是大名鼎鼎的“末日种子库”。\n建在北极冻土里，存着各种农作物的种子。\n万一以后发生核战争或者超级大瘟疫导致绝种了，\n人类还能靠它拿出来重新种地。）"
  },
  {
   "sentence": 5,
   "chunk": 1,
   "source_English": "Essentially the planet's ultimate backup,",
   "text": "（Essentially the planet's ultimate backup：\n名词短语作状语，补充说明 it）"
  },
  {
   "sentence": 6,
   "chunk": 2,
   "source_English": "and only they can take their seeds out.",
   "text": "（take A out：把 A 取出）"
  },
  {
   "sentence": 7,
   "chunk": 1,
   "source_English": "The first retrieval came not after an asteroid strike",
   "text": "（not A but B：不是 A，而是 B）"
  },
  {
   "sentence": 8,
   "chunk": 1,
   "source_English": "ICARDA, a research centre whose gene bank stood near Aleppo,",
   "text": "（bank：库，存放某类东西备用的地方，\n如 gene bank 基因库、seed bank 种子库、\nblood bank 血库、data bank 数据库）"
  },
  {
   "sentence": 9,
   "chunk": 2,
   "source_English": "130 of the 325 boxes it had sent to the Arctic before the hostilities.",
   "text": "（130 of the 325 boxes：同位语，补充说明 samples；\nit had sent…：定语从句，修饰 boxes）"
  },
  {
   "sentence": 10,
   "chunk": 1,
   "source_English": "They included robust strains of wheat and barley tolerant of drought and heat.",
   "text": "（tolerant of drought and heat：后置定语，\n修饰 strains；\ntolerant of：耐……的）"
  },
  {
   "sentence": 11,
   "chunk": 2,
   "source_English": "and vigorous plants sprouted to regenerate its collection.",
   "text": "（他们把这些种子种下去，长出了非常棒的新庄稼。\n靠着这些新庄稼结出的种子，\n他们原本被战火毁掉的“种子库存”，终于重新建起来了。）"
  },
  {
   "sentence": 12,
   "chunk": 1,
   "source_English": "Once multiplication had gone far enough,",
   "text": "（once：一旦……就，引导时间状语从句）"
  },
  {
   "sentence": 12,
   "chunk": 2,
   "source_English": "a homecoming began in 2017, consignment by consignment,",
   "text": "（consignment by consignment：一批接一批）"
  },
  {
   "sentence": 12,
   "chunk": 3,
   "source_English": "restocking the Arctic stronghold.",
   "text": "（restocking…：现在分词短语作伴随状语）"
  },
  {
   "sentence": 14,
   "chunk": 2,
   "source_English": "meltwater ran into the roughly 100-metre entrance tunnel and solidified.",
   "text": "（年份说明：入口进水发生在2016年10月，\n2017年5月引发广泛报道；种子储藏区没有进水。）"
  },
  {
   "sentence": 15,
   "chunk": 1,
   "source_English": "The intrusion stopped short of the seeds,",
   "text": "（stop short of：没有到达）"
  },
  {
   "sentence": 15,
   "chunk": 2,
